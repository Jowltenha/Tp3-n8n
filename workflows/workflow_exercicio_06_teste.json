        660,
        0
      ],
      "parameters": {
        "jsCode": "// Mensagem enviada ao cliente antes de qualquer contato com o atendimento.\nconst linhas = $input.all().map(i => i.json).map(p => p.encontrado\n  ? { pedido_id: p.pedido_id, cliente: p.cliente_nome, status: p.status,\n      aviso_ao_cliente: `Ola, ${p.cliente_nome}! Seu pedido ${p.pedido_id} (${p.produto}) esta com status \"${p.status}\". ` +\n        `Local atual: ${p.localizacao_atual}. Previsao de entrega: ${p.previsao_entrega}.` }\n  : { pedido_id: p.pedido_id, status: 'nao_encontrado', aviso_ao_cliente: null });\nreturn [{ json: { relatorio: 'status_proativo', gerado_em: $now.toISO(), origem_dos_dados: 'sub-workflow de consulta de status (mesmo usado pelo agente)', total: linhas.length, pedidos: linhas } }];"
      }
    },
