    {
      "id": "e1e177d5-1004-5553-95e9-62975e4a899a",
      "name": "[AGENTE] Agente de Atendimento",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1460,
        -60
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $('[FUNCAO] Normalizar Mensagem').first().json.mensagem }}\n\n[Classificacao automatica: categoria {{ $json.categoria }}, urgencia {{ $json.urgencia }}]",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "Voce e o agente de atendimento da Vortice Logistica, uma transportadora. Responda em portugues do Brasil, de forma cordial, objetiva e em poucas frases.\nRegras:\n1. Sempre que o cliente perguntar sobre um pedido (status, localizacao, previsao, atraso, avaria ou entrega), chame a ferramenta consultar_status_pedido com o codigo do pedido ANTES de responder. Nunca invente status, datas ou localizacao: use apenas o que a ferramenta devolver.\n2. Se o cliente nao informar o codigo do pedido (formato PED-0000), peca o codigo.\n3. Se a ferramenta nao encontrar o pedido, diga isso e peca para o cliente conferir o codigo.\n4. Em caso de avaria, informe que o caso segue para a equipe de sinistros. Em caso de atraso, informe a nova previsao e o motivo registrado.",
          "returnIntermediateSteps": true,
          "enableStreaming": false
        }
      }
    },
