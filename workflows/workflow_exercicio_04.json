    {
      "id": "211b88a6-1081-5661-996f-4ae42d98783f",
      "name": "[FUNCAO] Normalizar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b = $json.body || {};\nreturn [{ json: {\n  pergunta_id: b.pergunta_id || ('PERG-' + $now.toFormat('yyyyMMdd-HHmmss') + '-' + $execution.id),\n  cliente_id: b.cliente_id || 'nao_informado',\n  session_id: b.session_id || b.cliente_id || ('sessao-' + $execution.id),\n  mensagem: String(b.mensagem || '').trim(),\n  origem: 'ex04',\n  recebido_em: $now.toISO()\n} }];"
      }
    },
    {
      "id": "34344715-b4b3-5d29-b5ed-f95408b8dfec",
      "name": "[AGENTE] Agente de Atendimento",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.mensagem }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "Voce e o agente de atendimento da Vortice Logistica, uma transportadora. Responda em portugues do Brasil, de forma cordial, objetiva e em poucas frases.\nRegras:\n1. Sempre que o cliente perguntar sobre um pedido (status, localizacao, previsao, atraso, avaria ou entrega), chame a ferramenta consultar_status_pedido com o codigo do pedido ANTES de responder. Nunca invente status, datas ou localizacao: use apenas o que a ferramenta devolver.\n2. Se o cliente nao informar o codigo do pedido (formato PED-0000), peca o codigo.\n3. Se a ferramenta nao encontrar o pedido, diga isso e peca para o cliente conferir o codigo.\n4. Em caso de avaria, informe que o caso segue para a equipe de sinistros. Em caso de atraso, informe a nova previsao e o motivo registrado.",
          "returnIntermediateSteps": true,
          "enableStreaming": false
        }
      }
    },
    {
      "id": "f396ce83-90fe-5445-bd26-9fa775be7ed4",
      "name": "[IA] Modelo de Linguagem (Agente)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        360,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "cc/claude-haiku-5-5"
        },
        "responsesApiEnabled": false,
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "X4WCOOQMDXqxOZAj",
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "f1d77095-b329-5401-94a1-86cb267ef7c9",
      "name": "consultar_status_pedido",
      "type": "n8n-nodes-base.dataTableTool",
      "typeVersion": 1.1,
      "position": [
        560,
        220
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Consulta o status de um pedido da Vortice Logistica na base de pedidos. Use sempre que o cliente perguntar sobre um pedido. Entrada: o codigo do pedido no formato PED-0000 (ex.: PED-3001). Devolve status, localizacao atual, previsao de entrega, transportadora e observacoes.",
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "ySVMM8aesnf7VT6s",
          "cachedResultName": "tp3_pedidos_clientes"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "pedido_id",
              "condition": "eq",
              "keyValue": "={{ $fromAI('pedido_id', `Codigo do pedido no formato PED-0000`, 'string') }}"
            }
          ]
        },
        "returnAll": true
      }
    },
    {
      "id": "7d0e2fd5-97fa-569a-90e8-4a0a90643358",
      "name": "[FUNCAO] Montar Resposta Final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "jsCode": "const a = $input.first().json;\nconst passos = (a.intermediateSteps || []).map(p => ({\n  ferramenta: p.action && p.action.tool,\n  entrada: p.action && p.action.toolInput,\n}));\nreturn [{ json: {\n  ...$('[FUNCAO] Normalizar Mensagem').first().json,\n  resposta: a.output,\n  agente_usou_ferramenta: passos.length > 0,\n  ferramentas_acionadas: passos,\n} }];"
      }
    },
    {
      "id": "a2f8c2c9-893f-51ce-9ebd-740162078c06",
      "name": "[SAIDA] Responder ao Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1020,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    }
