    {
      "id": "d0eb3eb7-be2a-5190-ba3d-1142b83243e1",
      "name": "[ESTADO] Reconstruir Historico (JSON)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Roda ANTES do agente: le o estado salvo por execucoes anteriores (talvez em outro servidor n8n).\nconst msg = $('[FUNCAO] Normalizar Mensagem').first().json;\nconst linha = $input.all().map(i => i.json).find(r => r.session_id);\nlet historico = [];\nlet contexto = {};\nif (linha) {\n  try { historico = JSON.parse(linha.historico_json || '[]'); } catch (e) { historico = []; }\n  try { contexto = JSON.parse(linha.contexto_json || '{}'); } catch (e) { contexto = {}; }\n}\nconst recente = historico.slice(-10);\nconst texto = recente.map(t => `Cliente: ${t.cliente}\\nAgente: ${t.agente}`).join('\\n\\n');\nconst prompt = (recente.length\n  ? `Historico desta conversa, recuperado do estado persistido (${recente.length} trocas):\\n${texto}\\n\\n`\n  : 'Esta e a primeira mensagem desta conversa (nenhum estado salvo).\\n\\n')\n  + `Nova mensagem do cliente: ${msg.mensagem}`;\nreturn [{ json: {\n  ...msg,\n  estado_encontrado: !!linha,\n  trocas_recuperadas: recente.length,\n  historico,\n  contexto,\n  criado_em: linha ? linha.criado_em : $now.toISO(),\n  prompt_agente: prompt\n} }];"
      }
    },
    {
      "id": "ffe5734e-dd21-546a-a41c-9e9a427b042b",
      "name": "[AGENTE] Agente de Atendimento",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        900,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt_agente }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "Voce e o agente de atendimento da Vortice Logistica, uma transportadora. Responda em portugues do Brasil, de forma cordial, objetiva e em poucas frases.\nRegras:\n1. Sempre que o cliente perguntar sobre um pedido (status, localizacao, previsao, atraso, avaria ou entrega), chame a ferramenta consultar_status_pedido com o codigo do pedido ANTES de responder. Nunca invente status, datas ou localizacao: use apenas o que a ferramenta devolver.\n2. Se o cliente nao informar o codigo do pedido (formato PED-0000), peca o codigo.\n3. Se a ferramenta nao encontrar o pedido, diga isso e peca para o cliente conferir o codigo.\n4. Em caso de avaria, informe que o caso segue para a equipe de sinistros. Em caso de atraso, informe a nova previsao e o motivo registrado.\n5. Esta e uma conversa com varias mensagens. Use o que o cliente ja informou antes (nome, codigo do pedido, problema relatado) e nao peca de novo uma informacao que ja foi dada.",
          "returnIntermediateSteps": true,
          "enableStreaming": false
        }
      }
    },
